# ============================================================
#  SHOOTING STARS — Firebase Configuration Template
#  Copy this file to .env if you use a build tool.
#  For this vanilla-JS project, copy these values directly
#  into js/firebase.js (the public web config).
#
#  Obtain these values from:
#  Firebase Console → Project Settings → Your Apps → Web App → SDK setup
#
#  IMPORTANT: These are PUBLIC web configuration values.
#  They are safe to include in browser code.
#  NEVER include Admin SDK credentials or service-account private keys.
# ============================================================

FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id_here
